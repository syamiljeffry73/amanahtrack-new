[Unit]
Description=AmanahTrack donation box sensor client
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/amanahtrack_device
EnvironmentFile=/home/pi/amanahtrack_device/box.env
ExecStart=/usr/bin/python3 -u sensor_client.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
